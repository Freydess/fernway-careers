# Server-side settings for the careers page's own small server functions
# (api/apply.js, api/chat.js). The browser never sees any of these.
#
# Local development: copy this file to frontend/.env.local and fill it in.
# The backend's INTAKE_API_TOKEN is read automatically from the project root .env.
# On Vercel: add the same names under Project -> Settings -> Environment Variables.

# --- Applications (guided chat + AI chat) -> the Python backend -------------------
# Where the backend runs. Locally: .\scripts\run.ps1 api (from the project root).
BACKEND_URL=http://127.0.0.1:8000
# Same value as INTAKE_API_TOKEN in the project root .env. Only set it here (or on
# Vercel) if the backend's .env isn't next to this folder.
# INTAKE_API_TOKEN=
# "true" = don't call the backend; show the payload on the thank-you screen instead.
# Useful for presentations when the backend isn't running. Nothing is saved.
INTAKE_DEMO=false

# --- Fern, the AI recruiter (Path B) -------------------------------------------
# Free Groq API key from https://console.groq.com/keys (no credit card needed).
AI_API_KEY=
# Optional; defaults shown. Any OpenAI-compatible provider that supports
# response_format "json_schema" should work.
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
# "true" = Fern follows a scripted demo conversation instead of calling the AI.
AI_MOCK=false

# --- Both ---------------------------------------------------------------------
# Extra sites allowed to call these functions (comma-separated full origins).
# Requests from the site itself are always allowed.
# ALLOWED_ORIGINS=https://careers.example.com
