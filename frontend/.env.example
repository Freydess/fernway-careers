# Server-side settings for the site's own small server functions (api/chat.js and
# api/status.js). The browser never sees any of these.
#
# Local development: copy this file to frontend/.env.local and fill it in.
# On Vercel: add the same names under Project -> Settings -> Environment Variables.

# --- The marketplace (accounts, jobs, applications) -------------------------------
# "live" = use the Python backend's /api/v2. Vercel sends /api/v2 to Render (see
# vercel.json); locally, Vite sends it to BACKEND_URL.
# Anything else (or empty) = demo mode: the marketplace runs in each visitor's browser.
MARKETPLACE_MODE=demo
# Where the backend runs locally (only used when MARKETPLACE_MODE=live).
BACKEND_URL=http://127.0.0.1:8000

# --- Fern, the profile helper (AI chat) ------------------------------------------
# An OpenRouter key (https://openrouter.ai/keys), or a Groq key if AI_BASE_URL is Groq's.
AI_API_KEY=
# Optional. Without AI_BASE_URL the site uses Groq.
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-oss-120b
# "true" = Fern follows a scripted demo conversation instead of calling the AI.
AI_MOCK=false

# --- Both ---------------------------------------------------------------------
# Extra sites allowed to call these functions (comma-separated full origins).
# Requests from the site itself are always allowed.
# ALLOWED_ORIGINS=https://example.com
