DATABASE_URL=sqlite:///./data/employment.db
ADMIN_API_TOKEN=replace-with-a-random-admin-secret-of-32-or-more-characters
INTAKE_API_TOKEN=replace-with-a-different-random-intake-secret-of-32-or-more-characters
SYNC_MODE=disabled

